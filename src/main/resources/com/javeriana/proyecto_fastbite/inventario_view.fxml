<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.InventarioController">

    <Label text="INVENTARIO"/>

    <TableView fx:id="tableInventario"/>

    <TextField fx:id="txtCantidad"
               promptText="Cantidad"/>

    <Button text="Actualizar Stock"
            onAction="#actualizarStock"/>

</VBox>
